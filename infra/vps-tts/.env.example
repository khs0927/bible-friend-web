# Hostinger VPS control plane
VPS_TTS_API_TOKEN=replace-with-long-random-token
VPS_TTS_REDIS_URL=redis://redis:6379/0
VPS_TTS_CACHE_TTL_SECONDS=86400
VPS_TTS_MAX_TEXT_CHARS=1200

# Qwen3 inference upstream.
# On a normal Hostinger KVM VPS, point this at a separate Hostinger GPU instance.
# When running docker compose with --profile gpu on a GPU host, use http://qwen3-tts:8000
QWEN3_TTS_UPSTREAM_URL=https://your-gpu-service.example.com
QWEN3_TTS_UPSTREAM_TOKEN=replace-with-gpu-service-token
QWEN3_TTS_UPSTREAM_TIMEOUT_SECONDS=18

# Only used by the optional local GPU profile
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN3_TTS_SPEAKER=Sohee
QWEN3_TTS_API_TOKEN=replace-with-gpu-service-token
QWEN3_TTS_FLASH_ATTENTION=1
