# Copy to .env and fill in. Never commit .env (keys via WebDev Secrets in production).
# See README.md (environment table) and server/_core/env.ts for usages.

# App / auth
VITE_APP_ID=
JWT_SECRET=
DATABASE_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
NODE_ENV=development

# Built-in forge
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Gemini TTS
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_TIMEOUT_MS=30000
GEMINI_TTS_MAX_CHARS=900
GEMINI_TTS_DAILY_REQUESTS=80
