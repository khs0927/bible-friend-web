# Copy to .env and fill in. Never commit .env (keys via WebDev Secrets in production).
# See README.md (environment table) and server/_core/env.ts for usages.

# App / auth
VITE_APP_ID=
JWT_SECRET=
DATABASE_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
NODE_ENV=development

# Built-in forge
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# TTS routing
# Default: gemini_only (one audible voice during testing)
# Set fallback_chain later to enable Gemini -> Qwen3 -> CosyVoice.
BIBLE_FRIEND_TTS_MODE=gemini_only

# Gemini TTS
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_TIMEOUT_MS=8000
GEMINI_TTS_MAX_CHARS=900
GEMINI_TTS_DAILY_REQUESTS=80
GEMINI_TTS_DAILY_CHARS=20000


# Qwen3-TTS self-hosted fallback (optional, no per-request vendor quota)
QWEN3_TTS_API_URL=
QWEN3_TTS_API_TOKEN=
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN3_TTS_SPEAKER=Sohee
QWEN3_TTS_TIMEOUT_MS=20000

# Existing CosyVoice fallback (optional)
COSYVOICE_API_URL=
