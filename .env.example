# Bible Friend Web - Vercel environment template
# Copy these names into Vercel Project Settings > Environment Variables.
# Never commit real secret values.

# Required for Gemini TTS
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_TIMEOUT_MS=30000
GEMINI_TTS_HARD_TIMEOUT_MS=30000
GEMINI_TTS_MAX_CHARS=900
GEMINI_TTS_DAILY_REQUESTS=80
GEMINI_TTS_DAILY_CHARS=20000
GEMINI_TTS_RATE_LIMIT_COOLDOWN_MS=15000

# Optional TTS fallback
COSYVOICE_API_URL=

# Optional application services used by login/history/legacy Manus integrations
JWT_SECRET=
DATABASE_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
