{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "wordlight": {
      "runtime": "container",
      "root": "kotlin-wordlight/",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "wordlight" }
    }
  ]
}
