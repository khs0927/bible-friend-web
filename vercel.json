{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/voice-tts.js": {
      "maxDuration": 30
    },
    "api/voice-tts-stream.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/manus-storage/bible-friend-mascot_06125680.png",
      "dest": "/assets/bible-friend-mascot.svg"
    },
    {
      "src": "/manus-storage/bible-friend-chat-bg_371dab14.png",
      "dest": "/assets/bible-friend-chat-bg.svg"
    },
    {
      "src": "/manus-storage/game_banner_bg_51b6ddc7.png",
      "dest": "/assets/game-banner-bg.svg"
    },
    {
      "src": "/manus-storage/game_icon_trophy_8a4e9737.png",
      "dest": "/assets/game-icon-trophy.svg"
    },
    {
      "src": "/manus-storage/story_noah_a1e0e2bf.png",
      "dest": "/assets/stories/noah.svg"
    },
    {
      "src": "/manus-storage/story_david_0b7c9097.png",
      "dest": "/assets/stories/david.svg"
    },
    {
      "src": "/manus-storage/story_jesus_9ab7568d.png",
      "dest": "/assets/stories/jesus.svg"
    },
    {
      "src": "/manus-storage/story_creation_4ad3b88a.png",
      "dest": "/assets/stories/creation.svg"
    },
    {
      "src": "/manus-storage/story_creation_3e9569ce.png",
      "dest": "/assets/stories/solomon.svg"
    },
    {
      "src": "/manus-storage/story_joseph_aa32c037.png",
      "dest": "/assets/stories/joseph.svg"
    },
    {
      "src": "/api/trpc/tts\\.synthesize",
      "dest": "/api/voice-tts"
    },
    {
      "src": "/api/voice-tts-stream",
      "dest": "/api/voice-tts-stream"
    },
    {
      "src": "/api/voice-health",
      "dest": "/api/voice-tts"
    },
    {
      "src": "/api/voice-probe",
      "dest": "/api/voice-tts"
    },
    {
      "src": "/api/(?<path>.*)",
      "dest": "/api/vercel-handler?path=$path"
    },
    {
      "src": "/manus-storage/(.*)",
      "dest": "/api/vercel-handler?path=manus-storage/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
