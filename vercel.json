{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm exec vite build",
  "outputDirectory": "dist/public",
  "routes": [
    {
      "src": "/manus-storage/(.*)",
      "dest": "/api/manus-storage/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
