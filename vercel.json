{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm exec vitest run server/comicAssetProxy.test.ts server/tts.test.ts server/geminiTtsFetchCompat.test.ts client/src/lib/audioPlaybackQueue.test.ts && pnpm exec vite build && pnpm exec esbuild 'api/[...path].ts' --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=api/vercel-handler.js",
  "outputDirectory": "dist/public",
  "routes": [
    {
      "src": "/manus-storage/bible-friend-mascot_06125680.png",
      "dest": "/assets/bible-friend-mascot.svg"
    },
    {
      "src": "/manus-storage/bible-friend-chat-bg_371dab14.png",
      "dest": "/assets/bible-friend-chat-bg.svg"
    },
    {
      "src": "/manus-storage/game_banner_bg_51b6ddc7.png",
      "dest": "/assets/game-banner-bg.svg"
    },
    {
      "src": "/manus-storage/game_icon_trophy_8a4e9737.png",
      "dest": "/assets/game-icon-trophy.svg"
    },
    {
      "src": "/api/(?<path>.*)",
      "dest": "/api/vercel-handler?path=$path"
    },
    {
      "src": "/manus-storage/(.*)",
      "dest": "/api/vercel-handler?path=manus-storage/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
